# Copy this file to .env and add your key. .env is ignored by git.
# Get a free key at https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# Optional: sign-in and syncing trips across devices. Leave empty to turn it off.
# From Firebase console → Project settings → Your apps → firebaseConfig.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
